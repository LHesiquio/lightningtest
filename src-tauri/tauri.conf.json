{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lightningtest",
  "version": "0.1.0",
  "identifier": "dev.bumbu.lightningtest",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LightningTest",
        "width": 560,
        "height": 640,
        "minWidth": 420,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "publisher": "bumbu",
    "shortDescription": "Desktop GUI for the Ookla Speedtest CLI",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png"
    ]
  }
}
